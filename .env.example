# ── WhatsApp AI Bot Template — environment variables ─────────────────────
# Copy this file to .env and fill in real values. Never commit .env.
#
# When deploying to a hosting provider's dashboard (Render, Railway, etc.),
# type secrets in by hand rather than pasting — some provider UIs silently
# corrupt bulk-pasted values (trailing newline/space), which is a very hard
# bug to spot later since it just makes auth fail with no clear reason.

# --- WhatsApp Business Cloud API (Meta) — REQUIRED ---
# Create at developers.facebook.com > your app > WhatsApp > API Setup.
# The number itself must be registered/verified as a WhatsApp Business
# number in Meta Business Manager before this works.
VERIFY_TOKEN=choose-any-random-string-you-invent
WHATSAPP_TOKEN=your-permanent-access-token-from-meta
PHONE_NUMBER_ID=your-phone-number-id-from-meta

# Optional — the human-readable international number (no +), used to build
# "Chat on WhatsApp" deep links for your own website's dashboard button.
WHATSAPP_DISPLAY_NUMBER=

# --- AI provider — REQUIRED for the bot to answer questions ---
# Point this at whatever HTTP chat API you're using. See
# src/services/aiService.js — the request/response shape in
# callAiProvider() is written for a generic {message, system, history} ->
# {reply, sources} style API; adapt it to your actual provider.
AI_API_BASE_URL=https://your-ai-provider.example.com
AI_API_KEY=

# --- Knowledge base / Claims API — REQUIRED for the bot to cite real records ---
# Your own read-only source of truth (a fact-check archive, help-center
# index, product catalog, etc.). Without this, the bot still runs and
# chats normally, but every search comes back empty — it can never cite a
# specific published record, only answer from the AI's general knowledge.
CLAIMS_API_BASE_URL=https://your-knowledge-base.example.com/api/v1
CLAIMS_API_KEY=

# --- MongoDB (Atlas recommended) — REQUIRED for persistence ---
# Stores sessions/conversations, registered members, and broadcast history.
# Without MONGODB_URI the bot still runs, but forgets everything on restart.
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_DB_NAME=whatsapp-bot

# --- Admin dashboard login (/app) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string

# --- Company / escalation contact ---
COMPANY_NAME=Your Company
COMPANY_INDUSTRY=Customer Support
COMPANY_DESCRIPTION=Describe what this business does and what the WhatsApp assistant helps with. This is injected directly into the AI's system prompt.
COMPANY_WEBSITE=https://example.com
COMPANY_PHONE=+10000000000
COMPANY_EMAIL=hello@example.com
COMPANY_ADDRESS=
COMPANY_TONE=friendly, clear, helpful
COMPANY_BUSINESS_HOURS=Monday – Friday, 9:00 AM – 5:00 PM
# WhatsApp number the bot forwards "speak to a human" escalations to.
# Defaults to COMPANY_PHONE if unset — set a real human review team number.
ESCALATION_WHATSAPP=+10000000000

# --- Broadcasts (optional) ---
# Default country code (digits only, no +) used to normalize phone numbers
# uploaded without a "+" prefix — e.g. "233" for Ghana, "1" for US/Canada.
# Leave unset to require full international-format numbers in uploads.
DEFAULT_COUNTRY_CODE=

# --- Deployment ---
PORT=3000
# Set automatically on Render; set manually elsewhere (used for keep-alive pings + media URLs)
BASE_URL=
